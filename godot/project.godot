; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="雾隐汤屋2 · 像素动物温泉物语"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

GameManager="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=896
window/size/viewport_height=512
window/stretch/mode="viewport"
; 手机窗口常常比 896×512 还窄，整数缩放最低只能到 1 倍，多出来的画面直接被裁掉。
; 改成 fractional，让 896×512 的逻辑画布整体缩着放得下，代价只是像素不再是整数倍。
window/stretch/scale_mode="fractional"
; 4 = Sensor Landscape：网页版靠它提示浏览器锁横屏，竖着只会在中间留一条窄画面
window/handheld/orientation=4

[gui]

; 网页版没有系统字体可借，中文全靠这一张子集像素字体，否则满屏豆腐块
theme/custom="res://assets/ui/pixel_theme.tres"
; 1 = None：像素字体关掉抗锯齿才是一格一格的硬边，糊成灰边就白换了
theme/default_font_antialiasing=1
theme/default_font_hinting=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
